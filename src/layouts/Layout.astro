---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  locale?: 'en' | 'es';
}

const { title, description = '', locale = 'en' } = Astro.props;
const altLocale = locale === 'en' ? 'es' : 'en';
const path = Astro.url.pathname;
const stripped = path.replace(/^\/es(?=\/|$)/, '').replace(/^\/+/, '/');
const altHref = altLocale === 'es' ? `/es${stripped === '/' ? '/' : stripped}` : stripped;

const t = locale === 'es' ? {
  brand: 'Guía Trump Account',
  nav: { how: 'Cómo funciona', about: 'Acerca de', counselors: 'Para consejeros' },
  altLabel: 'EN',
  disclaimer:
    'Este sitio es un recurso educativo independiente, sin afiliación con ninguna agencia gubernamental, institución financiera ni con el Tesoro de EE. UU. Las proyecciones ejecutan una simulación Monte Carlo de 1,000 trayectorias sobre la distribución histórica de rendimientos mensuales del S&P 500 (≈10.5% anualizado después de un gasto del fondo de 0.10%/año, 1985–2026); la cifra mostrada es el resultado mediano. Los rendimientos reales pueden ser significativamente mayores o menores, incluyendo pérdidas. Las cifras son solo ilustrativas y no constituyen asesoramiento de inversión, fiscal ni legal. Consulte a un profesional cualificado antes de tomar decisiones financieras.',
} : {
  brand: 'Trump Account Guide',
  nav: { how: 'How it works', about: 'About', counselors: 'For counselors' },
  altLabel: 'ES',
  disclaimer:
    'This site is an independent educational resource, not affiliated with any government agency, financial institution, or the U.S. Treasury. Projections run a 1,000-path Monte Carlo over the historical S&P 500 monthly return distribution (≈10.5% annualized after a 0.10%/yr fund expense, 1985–2026); the headline is the median outcome. Actual returns can be substantially higher or lower, including losses. Numbers are illustrative only and are not investment, tax, or legal advice. Consult a qualified professional before making financial decisions.',
};

const home = locale === 'es' ? '/es/' : '/';
const howHref = locale === 'es' ? '/es/how-it-works' : '/how-it-works';
const aboutHref = locale === 'es' ? '/es/about' : '/about';
const counselorHref = locale === 'es' ? '/es/for-counselors' : '/for-counselors';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gradient-to-b from-yellow-50 to-white">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-xl items-center justify-between px-4 py-3">
        <a href={home} class="text-base font-bold text-brand-green-dark">{t.brand}</a>
        <div class="flex items-center gap-3 text-sm text-slate-600">
          <a href={howHref} class="hover:text-brand-green-dark">{t.nav.how}</a>
          <span class="text-slate-300">|</span>
          <a href={altHref} class="font-semibold hover:text-brand-green-dark">{t.altLabel}</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-slate-50 py-6">
      <div class="mx-auto w-full max-w-xl space-y-2 px-4 text-xs text-slate-500">
        <p>{t.disclaimer}</p>
        <p>
          <a href={aboutHref} class="underline">{t.nav.about}</a>
          ·
          <a href={howHref} class="underline">{t.nav.how}</a>
          ·
          <a href={counselorHref} class="underline">{t.nav.counselors}</a>
          ·
          <a href={altHref} class="underline">{t.altLabel === 'ES' ? 'Español' : 'English'}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
